# AI Survival World — environment configuration
#
# Copy to `.env` and fill in. `.env` is ignored by Git (.gitignore) and by the
# Docker build context (.dockerignore), and it is never part of an image.
# Docker Compose reads `.env` from this folder automatically.
#
# Keep it readable by the deploying user only:  chmod 600 .env
#
# Every value below is read by the existing code with the same default, so the
# stack also starts with an empty file — only NPC conversation needs the key.

# ---------------------------------------------------------------------------
# LLM gateway (server/server.mjs + server/llm.mjs)
# ---------------------------------------------------------------------------

# API key for the LiteLLM gateway. REQUIRED for the NPCs to answer; without it
# the game runs and NPC chat degrades to the offline fallback lines.
# The key is used server-side only: never in the frontend bundle, never in a
# log line, never in Git. Put a real key here, keep this sample empty.
VIVES_LLM_KEY=

# Gateway base URL (OpenAI-compatible).
VIVES_LLM_URL=https://api.llm.mechatronics.be/v1

# Preferred NPC model. The server re-resolves the model at runtime when the
# gateway key is not allowed to use it (see server/llm.mjs).
VIVES_MODEL=qwen3.8-27b

# ---------------------------------------------------------------------------
# Persistence (server/server.mjs + server/store.mjs)
# ---------------------------------------------------------------------------

# File where the shared world (buildings, harvests, depleted nodes, day/night
# clock) and every player's profile are stored. In Docker this points inside
# the named volume, so it must stay under /data.
MP_STATE_FILE=/data/world-state.json

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Node server listens on. In Docker this is fixed to 8080 by
# compose.yaml (host 8080 -> container 8080); the value below only matters
# when running `npm start` directly on your machine (default: 3000).
PORT=3000

# ---------------------------------------------------------------------------
# NPC guardrails (cost and concurrency) — optional, defaults shown
# ---------------------------------------------------------------------------

# NPC messages allowed per player per refill window.
NPC_CHAT_BURST=5
# Milliseconds before one token of that budget is restored.
NPC_CHAT_REFILL_MS=5000
# Gateway calls in flight across all players.
NPC_MAX_INFLIGHT=4
# Forget a conversation after this many ms of silence.
NPC_MEMORY_TTL_MS=3600000
# How often the idle-conversation sweep runs (ms).
NPC_MEMORY_SWEEP_MS=300000

# ---------------------------------------------------------------------------
# World pacing — optional, defaults shown
# ---------------------------------------------------------------------------

# How often the shared clock is broadcast to clients (ms).
TIME_SYNC_MS=2000
# Bush regrowth after depletion (ms). Tests use a small value; production can
# leave the default.
BUSH_REGROW_MS=90000
