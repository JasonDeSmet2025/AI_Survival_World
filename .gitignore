# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent workspace (pi state: extensions, tasks, runtime) — never part of the game
.pi/

# Runtime data: the shared world state the server writes while it runs
server/data/

# Secrets: real environment (API keys) — never commit. .env.example is the template
.env
.env.*
!.env.example

# QA screenshots: regenerated by tools/qa-*.mjs on every run
tools/qa-out/

# Scratch probes from debugging sessions
*.tmp.mjs
backups/
